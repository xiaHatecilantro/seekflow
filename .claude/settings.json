{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node hooks/session-start.js",
        "timeout": 15000
      }
    ],
    "PostToolUse": [
      {
        "matcher": "tool == \"Edit\" || tool == \"Write\"",
        "type": "command",
        "command": "node hooks/post-edit.js \"$tool_input.file_path\"",
        "timeout": 10000
      }
    ],
    "PreToolUse": [
      {
        "matcher": "tool == \"Bash\" && (tool_input.command matches \"rm -rf|git push --force|git reset --hard|git clean -f|DROP TABLE|DELETE FROM\")",
        "type": "command",
        "command": "node hooks/pre-bash-guard.js \"$tool_input.command\"",
        "timeout": 5000
      }
    ],
    "SessionEnd": [
      {
        "type": "command",
        "command": "node hooks/session-end.js",
        "timeout": 15000
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node hooks/stop-check.js",
        "timeout": 10000
      }
    ],
    "PreCompact": [
      {
        "type": "command",
        "command": "node hooks/pre-compact.js",
        "timeout": 10000
      }
    ]
  }
}
